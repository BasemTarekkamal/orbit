#!/bin/sh
# staff-apify: run a vetted Apify scraper within the owner's budget.
# Staffroom toolbelt shim: runs core/tools/apify.py with this Mac's python3. See docs/toolbelt.md.
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
kit=$(cd "$(dirname "$self")/.." && pwd -P)
exec /usr/bin/env python3 "$kit/core/tools/apify.py" "$@"
