#!/bin/sh
# staff-connectors: find connectors (MCP servers) for your job, and see yours.
# Staffroom toolbelt shim: runs core/tools/connectors_cli.py with this Mac's python3. See docs/toolbelt.md.
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
kit=$(cd "$(dirname "$self")/.." && pwd -P)
exec /usr/bin/env python3 "$kit/core/tools/connectors_cli.py" "$@"
