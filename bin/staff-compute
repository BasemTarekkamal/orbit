#!/bin/sh
# staff-compute: run a heavy job on the owner's own GitHub, when they connected it (optional).
# Staffroom toolbelt shim: runs core/tools/compute.py with this Mac's python3. See docs/toolbelt.md.
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
kit=$(cd "$(dirname "$self")/.." && pwd -P)
exec /usr/bin/env python3 "$kit/core/tools/compute.py" "$@"
