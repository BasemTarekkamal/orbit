#!/usr/bin/env python3
"""orbit: set up and run your crew of AI employees on this computer (a Mac, Windows through WSL, or Linux).

  orbit demo [--stop]              look around first: a pretend team in the control panel, nothing to set up
  orbit setup                      first run: checks, your business, your chat bot, your first hire
  orbit start | stop | restart     the background service (starts when you log in)
  orbit status                     is it running, who works here
  orbit panel                      open the control panel in your browser
  orbit hire --name Sara --role "Market researcher" --scope "…" [--super] [--model sonnet]
  orbit list
  orbit pause | resume | retire <handle>
  orbit abilities <handle> [--default | --super | --on a,b --off c]
  orbit skills [<handle>] [--share NAME | --remove NAME | --export NAME DIR]   what they learned
  orbit run <handle> "<message>"   talk to someone right here in the terminal
  orbit secret telegram | slack | discord | apify | anthropic    save a token (typed hidden, stored only on this computer)
  orbit group <chat id> [--channel telegram|slack|discord]      use a group or channel as the team chat
  orbit doctor                     check everything the team needs
  orbit doctor --get-voice-model   download the speech model for voice notes and calls (~550 MB)
  orbit doctor --get-whisper       Windows/Linux: build the speech engine (whisper.cpp) for this computer
  orbit logs                       the service log

Your team's folder is ~/Staff (set STAFFROOM_HOME to move it). The kit itself is this folder.
"""
