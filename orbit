</dict></plist>
""" % (LABEL, py, os.path.join(KIT, "core", "staffd.py"), engine.HOME, out, out))


def launchctl(*a):
    return subprocess.run(["launchctl"] + list(a), capture_output=True, text=True)


def start():
    ensure_home()
    if osinfo.KIND != "mac":
        return start_other()
    write_plist()
    uid = os.getuid()
    launchctl("bootout", "gui/%d/%s" % (uid, LABEL))
    r = launchctl("bootstrap", "gui/%d" % uid, PLIST)
    if r.returncode != 0:
        say("Couldn't start the service: %s" % (r.stderr.strip() or r.stdout.strip()))
        return False
    for _ in range(15):
        if running():
            break
        time.sleep(1)
    say("Running. The team starts at login from now on. Control panel: `orbit panel`.")
    return True


def stop():
    if osinfo.KIND == "mac":
        launchctl("bootout", "gui/%d/%s" % (os.getuid(), LABEL))
    elif os.path.exists(UNIT) and systemd_user():
        subprocess.run(["systemctl", "--user", "stop", "orbit.service"], capture_output=True)
    else:
        stop_service_run()
    say("Stopped. `orbit start` to bring the team back.")


# Windows (WSL) and Linux. Linux with systemd: a user service. Windows: WSL closes Linux soon after its
# last window does, so the service is started from the Windows side (a hidden wsl.exe, which keeps Linux
# running) now and from the Startup folder at every login. Otherwise: a background process.
def systemd_user():
    try:
        return subprocess.run(["systemctl", "--user", "is-system-running"], capture_output=True, text=True,
                              timeout=10).stdout.strip() in ("running", "degraded", "starting")
    except (OSError, subprocess.TimeoutExpired):
        return False


def service_pid():
    try:
        with open(SERVICE_PID) as fh:
            pid = int(fh.read().strip())
        os.kill(pid, 0)
        return pid
    except (OSError, ValueError):
        return None


def stop_service_run():
    pid = service_pid()
    if not pid:
        return
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        return
    for _ in range(20):
        if not service_pid():
            break
        time.sleep(0.5)


def service_cmd():
    py = sys.executable if sys.executable and os.path.exists(sys.executable) else "/usr/bin/python3"
    return ["/usr/bin/env", "STAFFROOM_HOME=" + engine.HOME, py, os.path.join(KIT, "orbit"), "service-run"]


def service_run():
    """The service on Windows (WSL) and Linux without systemd: keeps staffd running, restarts it if it stops."""
    if service_pid():
        return                                             # already running
    os.makedirs(os.path.dirname(SERVICE_PID), exist_ok=True)
    with open(SERVICE_PID, "w") as fh:
        fh.write(str(os.getpid()))
    child = []

    def end(*_):
        if child and child[0].poll() is None:
            child[0].terminate()
            try:
                child[0].wait(10)
            except subprocess.TimeoutExpired:
                child[0].kill()
        try:
            os.remove(SERVICE_PID)
        except OSError:
            pass
        os._exit(0)
    signal.signal(signal.SIGTERM, end)
    signal.signal(signal.SIGINT, end)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    env = dict(os.environ, STAFFROOM_HOME=engine.HOME, PATH=":".join(osinfo.path_dirs()))
    out = open(os.path.join(engine.HOME, "team", "staffd.out"), "ab")
    while True:
        child[:] = [subprocess.Popen([sys.executable, os.path.join(KIT, "core", "staffd.py")], env=env,
                                     stdout=out, stderr=out, stdin=subprocess.DEVNULL)]
        child[0].wait()
        time.sleep(20)                                     # like launchd's ThrottleInterval


def _ps(script):
    """Runs a PowerShell script on the Windows side, passed encoded so no quoting can break it."""
    import base64
    exe = osinfo.which("powershell.exe") or "/mnt/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
    enc = base64.b64encode(script.encode("utf-16-le")).decode()
    return subprocess.run([exe, "-NoProfile", "-NonInteractive", "-EncodedCommand", enc], capture_output=True,
                          text=True, timeout=60, cwd="/mnt/c" if os.path.isdir("/mnt/c") else None)


def wsl_script():
    """PowerShell that writes a Startup shortcut (starts the service hidden at every Windows login) and runs
    the shortcut's command now. It's started through WMI: anything started straight from here would sit in
    WSL's job for this command and be closed with it."""
    import pwd                                             # as this Linux user, whoever WSL's default user is
    user = pwd.getpwuid(os.getuid()).pw_name
    args = " ".join(["-d", '"%s"' % osinfo.distro(), "-u", '"%s"' % user, "-e"] +
                    ['"%s"' % a for a in service_cmd()]).replace("'", "''")
    return ("$a = '%s'\n"
            "$lnk = Join-Path ([Environment]::GetFolderPath('Startup')) 'Orbit.lnk'\n"
            "$s = (New-Object -ComObject WScript.Shell).CreateShortcut($lnk)\n"
            "$s.TargetPath = \"$env:WINDIR\\System32\\conhost.exe\"\n"
            "$s.Arguments = '--headless wsl.exe ' + $a\n"
            "$s.WindowStyle = 7\n"
            "$s.Description = 'Orbit: your AI crew'\n"
            "$s.Save()\n"
            "$si = New-CimInstance -ClassName Win32_ProcessStartup -ClientOnly -Property @{ShowWindow = [uint16]0}\n"
            "$r = Invoke-CimMethod -ClassName Win32_Process -MethodName Create -Arguments @{\n"
            "  CommandLine = '\"' + $s.TargetPath + '\" ' + $s.Arguments; ProcessStartupInformation = $si}\n"
            "if ($r.ReturnValue -ne 0) { throw \"Windows couldn't start it (Win32_Process.Create: $($r.ReturnValue))\" }\n"
            % args)


def start_other():
    if osinfo.KIND == "linux" and systemd_user():
        os.makedirs(os.path.dirname(UNIT), exist_ok=True)
        py = sys.executable if sys.executable and os.path.exists(sys.executable) else "/usr/bin/python3"
        log = os.path.join(engine.HOME, "team", "staffd.out")
        with open(UNIT, "w") as fh:
            fh.write("[Unit]\nDescription=Orbit: your AI crew\n\n[Service]\nExecStart=%s %s\n"
                     "Environment=STAFFROOM_HOME=%s\nEnvironment=PATH=%s\nRestart=always\nRestartSec=20\n"
                     "StandardOutput=append:%s\nStandardError=append:%s\n\n[Install]\nWantedBy=default.target\n"
                     % (py, os.path.join(KIT, "core", "staffd.py"), engine.HOME, ":".join(osinfo.path_dirs()), log, log))
        subprocess.run(["systemctl", "--user", "daemon-reload"], capture_output=True)
        r = subprocess.run(["systemctl", "--user", "enable", "orbit.service"], capture_output=True, text=True)
        subprocess.run(["systemctl", "--user", "restart", "orbit.service"], capture_output=True)
        if r.returncode != 0:
            say("Couldn't start the service: %s" % (r.stderr.strip() or r.stdout.strip()))
            return False
        note = "Running. The team starts when you log in from now on. Control panel: `orbit panel`."
    elif osinfo.KIND == "wsl":
        stop_service_run()
        try:
            r = _ps(wsl_script())
        except (OSError, subprocess.TimeoutExpired) as e:
            say("Couldn't reach Windows to start the service (%s)." % e)
            return False
        if r.returncode != 0:
            say("Couldn't start the service from Windows: %s" % (r.stderr.strip()[-300:] or r.stdout.strip()[-300:]))
            return False
        note = "Running. The team starts when you log in to Windows from now on. Control panel: `orbit panel`."
    else:
        stop_service_run()
        subprocess.Popen(service_cmd(), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        note = ("Running until you log out (this Linux has no systemd user session, so it can't start at login: run "
                "`orbit start` again then). Control panel: `orbit panel`.")
    for _ in range(30):
        if running():
            break
        time.sleep(1)
    if not running():
        if osinfo.KIND == "wsl" and not service_pid():
            say("Windows didn't start the background service (nothing reached Linux). Try `orbit start` again; "
                "if it keeps failing, run `orbit service-run` in this window and leave it open.")
        else:
            say("The service didn't come up. `orbit logs` shows why.")
        return False
    say(note)
    return True


