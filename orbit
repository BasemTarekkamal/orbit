def claude_status():
    c = engine.resolve_claude()
    if not shutil.which(c) and not os.path.exists(c):
        return False, "Claude Code isn't installed. Install it from https://claude.com/claude-code, then run `claude` once to sign in."
    env = {k: v for k, v in os.environ.items() if not k.startswith(("ANTHROPIC_", "CLAUDE_CODE_")) and k != "CLAUDECODE"}
    r = subprocess.run([c, "auth", "status"], capture_output=True, text=True, env=env)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        d = {}
    if not d.get("loggedIn"):
        return False, "Claude Code isn't signed in. Run `claude auth login` and sign in with your own Claude account."
    return True, "Claude Code signed in (%s)" % d.get("authMethod", "ok")


def checks():
    out = []
    ok, msg = claude_status()
    out.append((ok, msg, True))
    out.extend(platform_checks())
    out.append((bool(shutil.which("git")), "git", True))
    for mod, why in (("requests", "page reader"), ("bs4", "page reader"), ("playwright", "headless browser")):
        try:
            __import__(mod)
            out.append((True, "python %s (%s)" % (mod, why), False))
        except ImportError:
            out.append((False, "python %s missing (%s): pip3 install --user requests beautifulsoup4 playwright" % (mod, why), False))
    for b, why in (("ffmpeg", "voice notes"), ("whisper-cli", "voice notes")):
        found = osinfo.which(b)
        if osinfo.KIND == "mac":
            fix = "brew install ffmpeg whisper-cpp"
        else:
            fix = "sudo sh %s/setup-linux.sh" % KIT if b == "ffmpeg" else "orbit doctor --get-whisper"
        out.append((bool(found), "%s (%s)%s" % (b, why, "" if found else ": " + fix), False))
    model = os.path.join(engine.HOME, "models", "ggml-large-v3-turbo-q5_0.bin")
    out.append((os.path.exists(model), "speech model%s" % ("" if os.path.exists(model) else ": `orbit doctor --get-voice-model` (~550 MB)"), False))
    import calls
    ok, why = calls.ready()
    out.append((ok, "live calls%s" % ("" if ok else ": " + why), False))
    import channels
    conf = channels.configured()
    out.append((bool(conf), "chat channel%s" % ((": " + ", ".join(conf)) if conf else " (none yet): `orbit secret telegram|slack|discord`"), False))
    if "slack" in conf or "discord" in conf:
        try:
            __import__("websocket")
            out.append((True, "python websocket-client (Slack/Discord)", False))
        except ImportError:
            out.append((False, "python websocket-client missing (Slack/Discord can't listen): pip3 install --user websocket-client", False))
    out.append((running(), "service running%s" % ("" if running() else ": `orbit start`"), False))
    return out


def platform_checks():
    """The computer itself: macOS, or Windows/Linux with the sandbox's two helpers (bubblewrap, socat)."""
    if osinfo.KIND == "mac":
        return [(True, "macOS (the sandbox and the service)", True)]
    if not osinfo.SUPPORTED:
        return [(False, "%s isn't supported: Orbit runs on a Mac, on Windows (through WSL) or on Linux" % sys.platform, True)]
    out = []
    setup = "run once, it asks your password:  sudo sh %s/setup-linux.sh" % KIT
    if osinfo.KIND == "wsl":
        wsl1 = os.uname().release.endswith("-Microsoft")      # WSL 1's kernel name; WSL 2's says microsoft-standard
        out.append((not wsl1, "Windows, through WSL 2%s" % (
            (": this is WSL 1, which can't sandbox. In PowerShell run  wsl --set-version %s 2"
             % (osinfo.distro() or "Ubuntu")) if wsl1 else ""), True))
    else:
        out.append((True, "Linux", True))
    miss = [b for b in ("bwrap", "socat") if not osinfo.which(b)]
    out.append((not miss, "the sandbox (bubblewrap, socat)%s" % ((": missing %s, %s" % (", ".join(miss), setup)) if miss else ""), True))
    try:
        with open("/proc/sys/kernel/apparmor_restrict_unprivileged_userns") as fh:
            restricted = fh.read().strip() == "1"
    except OSError:
        restricted = False
    if restricted and not os.path.exists("/etc/apparmor.d/bwrap"):
        out.append((False, "the sandbox is blocked by AppArmor: " + setup, True))
    found = osinfo.which("tesseract")
    out.append((bool(found), "tesseract (reading scans and photos)%s" % ("" if found else ": " + setup), False))
    return out


def running():
    try:
        return time.time() - os.path.getmtime(os.path.join(engine.HOME, "team", "staffd_alive")) < 120
    except OSError:
        return False


