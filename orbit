def get_whisper():
    """Windows/Linux: builds whisper.cpp (the speech engine; Homebrew has it on a Mac) from its latest release
    into ~/Staff/cache and links whisper-cli into ~/.local/bin. Needs git, cmake and a C++ compiler
    (setup-linux.sh installs them). A few minutes, once."""
    import re
    if osinfo.KIND == "mac":
        say("On a Mac: brew install whisper-cpp")
        return
    miss = [b for b in ("git", "cmake", "c++") if not osinfo.which(b)]
    if miss:
        sys.exit("Building the speech engine needs %s: sudo sh %s/setup-linux.sh" % (", ".join(miss), KIT))
    src = os.path.join(engine.HOME, "cache", "whisper.cpp")
    tags = subprocess.run(["git", "ls-remote", "--tags", "--refs", "https://github.com/ggml-org/whisper.cpp"],
                          capture_output=True, text=True).stdout
    vers = sorted({tuple(int(x) for x in m) for m in re.findall(r"refs/tags/v(\d+)\.(\d+)\.(\d+)$", tags, re.M)})
    tag = "v%d.%d.%d" % vers[-1] if vers else None
    shutil.rmtree(src, ignore_errors=True)
    say("Downloading whisper.cpp %s from github.com/ggml-org/whisper.cpp…" % (tag or "(latest)"))
    subprocess.run(["git", "clone", "-q", "--depth", "1"] + (["--branch", tag] if tag else []) +
                   ["https://github.com/ggml-org/whisper.cpp", src], check=True)
    say("Building it for this computer (a few minutes)…")
    subprocess.run(["cmake", "-B", "build", "-DCMAKE_BUILD_TYPE=Release", "-DWHISPER_BUILD_TESTS=OFF",
                    "-DWHISPER_BUILD_EXAMPLES=ON"], cwd=src, check=True, stdout=subprocess.DEVNULL)
    subprocess.run(["cmake", "--build", "build", "-j", str(os.cpu_count() or 2), "--config", "Release",
                    "--target", "whisper-cli"], cwd=src, check=True, stdout=subprocess.DEVNULL)
    exe = os.path.join(src, "build", "bin", "whisper-cli")
    dst = os.path.expanduser("~/.local/bin/whisper-cli")
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    if os.path.lexists(dst):
        os.remove(dst)
    os.symlink(exe, dst)
    say("✓ whisper-cli installed (%s)" % dst)


