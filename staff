#!/usr/bin/env python3
"""staff: set up and run your team of AI employees on this Mac.

  staff demo [--stop]              look around first: a pretend team in the control panel, nothing to set up
  staff setup                      first run: checks, your business, your chat bot, your first hire
  staff start | stop | restart     the background service (starts at login)
  staff status                     is it running, who works here
  staff panel                      open the control panel in your browser
  staff hire --name Sara --role "Market researcher" --scope "…" [--super] [--model sonnet]
  staff list
  staff pause | resume | retire <handle>
  staff abilities <handle> [--default | --super | --on a,b --off c]
  staff skills [<handle>] [--share NAME | --remove NAME | --export NAME DIR]   what they learned
  staff run <handle> "<message>"   talk to someone right here in the terminal
  staff secret telegram | slack | discord | apify | anthropic    save a token (typed hidden, stored only on this Mac)
  staff group <chat id> [--channel telegram|slack|discord]      use a group or channel as the team chat
  staff doctor                     check everything the team needs
  staff logs                       the service log

Your team's folder is ~/Staff (set STAFFROOM_HOME to move it). The kit itself is this folder.
"""
from __future__ import annotations

import argparse
import getpass
import json
import os
import shutil
import subprocess
import sys
import time
import urllib.request

KIT = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(KIT, "core"))
sys.path.insert(0, os.path.join(KIT, "core", "tools"))
import engine  # noqa: E402

LABEL = "com.staffroom.staffd"
PLIST = os.path.expanduser("~/Library/LaunchAgents/%s.plist" % LABEL)
SECRET_NAMES = {"telegram": [("telegram_bot_token", "bot token from @BotFather")],
                "slack": [("slack_bot_token", "Bot User OAuth Token (xoxb-…)"),
                          ("slack_app_token", "App-Level Token with connections:write (xapp-…)")],
                "discord": [("discord_bot_token", "bot token from the Developer Portal")],
                "apify": [("apify_token", "API token")], "anthropic": [("anthropic_api_key", "API key")]}


def say(msg=""):
    print(msg)


def ask(q, default=""):
    try:
        a = input("%s%s: " % (q, " [%s]" % default if default else "")).strip()
    except EOFError:
        a = ""
    return a or default


def yes(q, default=True):
    a = ask(q + (" (Y/n)" if default else " (y/N)")).lower()
    return default if not a else a.startswith("y")


def save_secret(name, value):
    os.makedirs(engine.SECRETS, exist_ok=True)
    os.chmod(engine.SECRETS, 0o700)
    p = os.path.join(engine.SECRETS, name)
    with open(p, "w") as fh:
        fh.write(value.strip())
    os.chmod(p, 0o600)


def tg(tok, method, params=None):
    import urllib.parse
    data = urllib.parse.urlencode(params or {}).encode()
    try:
        with urllib.request.urlopen(urllib.request.Request("https://api.telegram.org/bot%s/%s" % (tok, method), data=data), timeout=40) as r:
            return json.loads(r.read().decode())
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "description": str(e)}


def ensure_home():
    os.makedirs(os.path.join(engine.HOME, "team"), exist_ok=True)
    os.makedirs(os.path.join(engine.HOME, "employees"), exist_ok=True)
    if not os.path.exists(engine.REGISTRY):
        reg = {"team_name": "My team", "owners": {}, "employees": {}, "auth": "subscription",
               "defaults": {"model": "sonnet", "fallback_model": "haiku", "effort": "medium"},
               "workdays": ["Mon", "Tue", "Wed", "Thu", "Fri"], "network_domains": [],
               "apify": {"monthly_budget_usd": 5, "max_run_usd": 0.5}, "team_chats": {},
               "panel": {"port": 7317}}
        engine.save_registry(reg)
    with open(os.path.join(engine.HOME, ".gitignore"), "w") as fh:
        fh.write(".secrets/\n.runtime/\nemployees/\nteam/*.log\nteam/staffd_alive\nteam/offsets.json\nmodels/\nstate/\n")
    if not os.path.isdir(os.path.join(engine.HOME, ".git")):
        subprocess.run(["git", "init", "-q"], cwd=engine.HOME)
    engine.save_registry(engine.registry(), "team folder set up")


# ------------------------------------------------------------------ checks
def claude_status():
    c = engine.resolve_claude()
    if not shutil.which(c) and not os.path.exists(c):
        return False, "Claude Code isn't installed. Install it from https://claude.com/claude-code, then run `claude` once to sign in."
    env = {k: v for k, v in os.environ.items() if not k.startswith(("ANTHROPIC_", "CLAUDE_CODE_")) and k != "CLAUDECODE"}
    r = subprocess.run([c, "auth", "status"], capture_output=True, text=True, env=env)
    try:
        d = json.loads(r.stdout)
    except ValueError:
        d = {}
    if not d.get("loggedIn"):
        return False, "Claude Code isn't signed in. Run `claude auth login` and sign in with your own Claude account."
    return True, "Claude Code signed in (%s)" % d.get("authMethod", "ok")


def checks():
    out = []
    ok, msg = claude_status()
    out.append((ok, msg, True))
    out.append((sys.platform == "darwin", "macOS (the sandbox and the service need it)", True))
    out.append((bool(shutil.which("git")), "git", True))
    for mod, why in (("requests", "page reader"), ("bs4", "page reader"), ("playwright", "headless browser")):
        try:
            __import__(mod)
            out.append((True, "python %s (%s)" % (mod, why), False))
        except ImportError:
            out.append((False, "python %s missing (%s): pip3 install --user requests beautifulsoup4 playwright" % (mod, why), False))
    for b, why in (("ffmpeg", "voice notes"), ("whisper-cli", "voice notes"), ("node", "not required")):
        if b == "node":
            continue
        found = shutil.which(b) or os.path.exists("/opt/homebrew/bin/" + b)
        out.append((bool(found), "%s (%s)%s" % (b, why, "" if found else ": brew install ffmpeg whisper-cpp"), False))
    model = os.path.join(engine.HOME, "models", "ggml-large-v3-turbo-q5_0.bin")
    out.append((os.path.exists(model), "speech model%s" % ("" if os.path.exists(model) else ": `staff doctor --get-voice-model` (~550 MB)"), False))
    import channels
    conf = channels.configured()
    out.append((bool(conf), "chat channel%s" % ((": " + ", ".join(conf)) if conf else " (none yet): `staff secret telegram|slack|discord`"), False))
    if "slack" in conf or "discord" in conf:
        try:
            __import__("websocket")
            out.append((True, "python websocket-client (Slack/Discord)", False))
        except ImportError:
            out.append((False, "python websocket-client missing (Slack/Discord can't listen): pip3 install --user websocket-client", False))
    out.append((running(), "service running%s" % ("" if running() else ": `staff start`"), False))
    return out


def running():
    try:
        return time.time() - os.path.getmtime(os.path.join(engine.HOME, "team", "staffd_alive")) < 120
    except OSError:
        return False


# ------------------------------------------------------------------ service
def write_plist():
    py = sys.executable if sys.executable and os.path.exists(sys.executable) else "/usr/bin/python3"
    os.makedirs(os.path.dirname(PLIST), exist_ok=True)
    out = os.path.join(engine.HOME, "team", "staffd.out")
    with open(PLIST, "w") as fh:
        fh.write("""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>%s</string>
  <key>ProgramArguments</key><array><string>%s</string><string>%s</string></array>
  <key>EnvironmentVariables</key><dict><key>STAFFROOM_HOME</key><string>%s</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>20</integer>
  <key>StandardOutPath</key><string>%s</string><key>StandardErrorPath</key><string>%s</string>
</dict></plist>
""" % (LABEL, py, os.path.join(KIT, "core", "staffd.py"), engine.HOME, out, out))


def launchctl(*a):
    return subprocess.run(["launchctl"] + list(a), capture_output=True, text=True)


def start():
    ensure_home()
    write_plist()
    uid = os.getuid()
    launchctl("bootout", "gui/%d/%s" % (uid, LABEL))
    r = launchctl("bootstrap", "gui/%d" % uid, PLIST)
    if r.returncode != 0:
        say("Couldn't start the service: %s" % (r.stderr.strip() or r.stdout.strip()))
        return False
    for _ in range(15):
        if running():
            break
        time.sleep(1)
    say("Running. The team starts at login from now on. Control panel: `staff panel`.")
    return True


def stop():
    launchctl("bootout", "gui/%d/%s" % (os.getuid(), LABEL))
    say("Stopped. `staff start` to bring the team back.")


def panel_url():
    import panel
    return panel.url()


# ------------------------------------------------------------------ setup
def pair_owner(tok):
    say("\nOpen your bot in Telegram and send it any message (for example: hello).")
    say("Waiting up to 2 minutes…")
    offset, deadline = 0, time.time() + 120
    while time.time() < deadline:
        res = tg(tok, "getUpdates", {"offset": offset, "timeout": 20, "allowed_updates": json.dumps(["message"])})
        for u in res.get("result", []):
            offset = u["update_id"] + 1
            m = u.get("message") or {}
            frm = m.get("from") or {}
            if m.get("chat", {}).get("type") == "private" and frm.get("id"):
                name = " ".join(x for x in (frm.get("first_name"), frm.get("last_name")) if x) or "you"
                if yes("Got a message from %s (@%s, id %s). Is that you?" % (name, frm.get("username") or "-", frm["id"])):
                    tg(tok, "getUpdates", {"offset": offset})          # mark it read
                    return str(frm["id"])
    say("No message arrived. You can add yourself later: message the bot, then approve yourself in the control panel.")
    return None


def setup(no_start=False):
    say("Setting up your AI team. Your data stays in %s on this Mac.\n" % engine.HOME)
    ok, msg = claude_status()
    say(("✓ " if ok else "✗ ") + msg)
    if not ok:
        sys.exit(1)
    if sys.platform != "darwin":
        sys.exit("This kit runs on macOS for now (it relies on the macOS sandbox and launchd).")
    ensure_home()
    reg = engine.registry()
    reg["team_name"] = ask("\nYour team or business name", reg.get("team_name") or "My team")
    me = ask("Your first name (how employees will call you)", next(iter(reg.get("owners", {}).values()), {}).get("name", ""))
    about_f = os.path.join(engine.HOME, "team", "ABOUT.md")
    if not os.path.exists(about_f) or yes("Describe your business again?", False):
        say("\nIn 2–5 sentences, what does the business do, for whom, and what matters most right now?")
        about = ask("About")
        with open(about_f, "w", encoding="utf-8") as fh:
            fh.write("# %s\n\n%s\n\nOwner: %s.\n" % (reg["team_name"], about or "(not described yet: owners, add it in Settings)", me))
    engine.save_registry(reg, "setup: team name")

    say("\nA chat bot lets you talk to your team from your phone (optional, recommended). Telegram is the quickest;")
    say("Slack and Discord work too: `staff secret slack` / `staff secret discord` later, steps in docs/channels.md.")
    say("Telegram: open it, message @BotFather, send /newbot, and copy the token it gives you.")
    tok = engine.secret("telegram_bot_token")
    if tok and not yes("A bot token is already saved. Keep it?"):
        tok = None
    if not tok:
        t = getpass.getpass("Paste the bot token (hidden; Enter to skip): ").strip()
        if t:
            me_bot = tg(t, "getMe")
            if me_bot.get("ok"):
                save_secret("telegram_bot_token", t)
                tok = t
                say("✓ Connected to @%s" % me_bot["result"]["username"])
            else:
                say("That token didn't work (%s). Add it later with `staff secret telegram`." % me_bot.get("description"))
    owner_id = None
    if tok and not any(o.get("name") == me for o in reg.get("owners", {}).values()):
        owner_id = pair_owner(tok)
    reg = engine.registry()
    if owner_id:
        reg.setdefault("owners", {})[owner_id] = {"name": me, "aliases": []}
    elif not reg.get("owners"):
        reg["owners"] = {"local-%s" % me.lower(): {"name": me, "aliases": [], "local": True}}
    engine.save_registry(reg, "setup: owner %s" % me)

    say("\nApify gives employees TikTok, Instagram, Facebook, X, YouTube, LinkedIn and Google Maps research.")
    say("It's paid per use (a free Apify account includes $5 of credit a month). Employees stay inside the budget you set.")
    if not engine.secret("apify_token") and yes("Add an Apify token now?", False):
        t = getpass.getpass("Apify API token (console.apify.com → Settings → Integrations; hidden): ").strip()
        if t:
            save_secret("apify_token", t)

    import hire
    if not reg.get("employees") and yes("\nHire your first employee now?"):
        name = ask("Their name", "Sara")
        role = ask("Their role", "Research assistant")
        scope = ask("What they own (one or two sentences)", "Research anything I ask; watch competitors and our market; brief me every morning")
        sup = yes("Make them a super agent (every ability on)?", False)
        h = hire.hire(name, role, scope, supervisor=me, preset="super" if sup else "default")
        say("✓ Hired %s. Message them with /%s on Telegram (@%s on Slack or Discord), or in the control panel." % (name, h, h))
    hire.directory()
    say("")
    if no_start:
        say("Done (service not started: --no-start). Start it with `staff start`.")
        return
    if start():
        say("\nControl panel: %s" % panel_url())
        subprocess.run(["open", panel_url()], capture_output=True)
    say("\nRun `staff doctor` any time to check voice notes, the browser and the rest.")


# ------------------------------------------------------------------ demo
def demo(stop=False):
    """A pretend team in the panel: its own folder (~/.staffroom-demo), its own port, canned answers, no bot."""
    import secrets as _secrets
    import signal
    home = os.path.expanduser("~/.staffroom-demo")
    pidf = os.path.join(home, "team", "demo.pid")
    port = 7318
    try:
        with open(pidf) as fh:
            pid = int(fh.read().strip())
        os.kill(pid, 0)
    except (OSError, ValueError):
        pid = None
    if stop:
        if pid:
            os.kill(pid, signal.SIGTERM)
            say("Demo stopped. The pretend team's folder stays in %s until the next `staff demo`." % home)
        else:
            say("The demo isn't running.")
        return
    tokf = os.path.join(home, ".secrets", "panel_token")
    if pid:
        with open(tokf) as fh:
            tok = fh.read().strip()
        u = "http://127.0.0.1:%d/?t=%s" % (port, tok)
        say("The demo is already running: %s" % u)
        subprocess.run(["open", u], capture_output=True)
        return
    shutil.rmtree(home, ignore_errors=True)
    os.makedirs(os.path.join(home, ".secrets"), mode=0o700)
    os.makedirs(os.path.join(home, "team"))
    tok = _secrets.token_urlsafe(24)
    with open(tokf, "w") as fh:
        fh.write(tok)
    os.chmod(tokf, 0o600)
    env = dict(os.environ, STAFFROOM_HOME=home, STAFFROOM_DEMO="1")
    out = open(os.path.join(home, "team", "demo.out"), "ab")
    p = subprocess.Popen([sys.executable, os.path.join(KIT, "core", "demo.py")], env=env, stdout=out, stderr=out, start_new_session=True)
    with open(pidf, "w") as fh:
        fh.write(str(p.pid))
    say("Seeding a pretend team…")
    alive = os.path.join(home, "team", "staffd_alive")
    for _ in range(40):
        if os.path.exists(alive) or p.poll() is not None:
            break
        time.sleep(0.5)
    if p.poll() is not None:
        sys.exit("The demo didn't start; see %s" % os.path.join(home, "team", "demo.out"))
    u = "http://127.0.0.1:%d/?t=%s" % (port, tok)
    say("Demo running: %s\nNothing in it is real. `staff demo --stop` ends it; `staff setup` starts your own team." % u)
    subprocess.run(["open", u], capture_output=True)


# ------------------------------------------------------------------ main
def main():
    ap = argparse.ArgumentParser(prog="staff", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    sub.add_parser("setup").add_argument("--no-start", action="store_true", help="don't install or start the service")
    sub.add_parser("demo").add_argument("--stop", action="store_true", help="end the demo")
    for c in ("start", "stop", "restart", "status", "panel", "list", "logs"):
        sub.add_parser(c)
    d = sub.add_parser("doctor")
    d.add_argument("--get-voice-model", action="store_true")
    h = sub.add_parser("hire")
    h.add_argument("--name", required=True); h.add_argument("--role", required=True); h.add_argument("--scope", default="")
    h.add_argument("--supervisor", default=""); h.add_argument("--handle"); h.add_argument("--super", action="store_true")
    h.add_argument("--model", choices=["opus", "sonnet", "haiku"])
    for c in ("pause", "resume", "retire"):
        sub.add_parser(c).add_argument("handle")
    a = sub.add_parser("abilities")
    a.add_argument("handle"); a.add_argument("--default", action="store_true"); a.add_argument("--super", action="store_true")
    a.add_argument("--on", default=""); a.add_argument("--off", default="")
    r = sub.add_parser("run")
    r.add_argument("handle"); r.add_argument("message")
    k = sub.add_parser("skills")
    k.add_argument("handle", nargs="?"); k.add_argument("--share", metavar="NAME"); k.add_argument("--remove", metavar="NAME")
    k.add_argument("--export", nargs=2, metavar=("NAME", "DIR"))
    s = sub.add_parser("secret")
    s.add_argument("name", choices=sorted(SECRET_NAMES))
    g = sub.add_parser("group")
    g.add_argument("chat_id"); g.add_argument("--channel", choices=["telegram", "slack", "discord"])
    args = ap.parse_args()

    if args.cmd in (None, "help"):
        print(__doc__)
        return
    if args.cmd == "setup":
        return setup(no_start=args.no_start)
    if args.cmd == "demo":
        return demo(stop=args.stop)
    if args.cmd == "start":
        return start()
    if args.cmd == "stop":
        return stop()
    if args.cmd == "restart":
        stop()
        return start()
    if args.cmd == "secret":
        vals = {}
        for fname, label in SECRET_NAMES[args.name]:
            v = getpass.getpass("Paste the %s %s (hidden): " % (args.name.capitalize() if args.name in ("telegram", "slack", "discord") else args.name, label)).strip()
            if not v:
                sys.exit("Nothing saved.")
            vals[fname] = v
        if args.name == "telegram" and not tg(vals["telegram_bot_token"], "getMe").get("ok"):
            sys.exit("Telegram didn't accept that token.")
        for fname, v in vals.items():
            save_secret(fname, v)
        if args.name in ("slack", "discord"):
            import channels
            ok, note = channels.get(args.name).check()
            if not ok:
                for fname in vals:
                    os.remove(os.path.join(engine.SECRETS, fname))
                sys.exit("%s didn't accept that: %s. Nothing saved." % (args.name.capitalize(), note))
            say("✓ Connected as %s" % note)
            try:
                __import__("websocket")
            except ImportError:
                say("One more thing so the service can listen: pip3 install --user websocket-client")
        if args.name == "anthropic":
            reg = engine.registry()
            reg["auth"] = "api_key" if yes("Use this API key instead of your Claude subscription? (billed to your Anthropic account)", False) else "subscription"
            engine.save_registry(reg, "auth: %s" % reg["auth"])
        say("Saved. `staff restart` to apply.")
        return
    if args.cmd == "doctor":
        if args.get_voice_model:
            dst = os.path.join(engine.HOME, "models", "ggml-large-v3-turbo-q5_0.bin")
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            say("Downloading the speech model (~550 MB) from Hugging Face (ggerganov/whisper.cpp)…")
            subprocess.run(["curl", "-L", "--fail", "-o", dst + ".part",
                            "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo-q5_0.bin"], check=True)
            os.replace(dst + ".part", dst)
        bad = 0
        for ok, msg, must in checks():
            say(("✓ " if ok else ("✗ " if must else "· ")) + msg)
            bad += (not ok and must)
        sys.exit(1 if bad else 0)
    if args.cmd == "panel":
        u = panel_url()
        say(u)
        if not running():
            say("(the service isn't running: `staff start`)")
        subprocess.run(["open", u], capture_output=True)
        return
    if args.cmd == "logs":
        subprocess.run(["tail", "-n", "60", os.path.join(engine.HOME, "team", "staffd.log")])
        return

    import abilities
    import hire
    import skillbook
    if args.cmd in ("status", "list"):
        if args.cmd == "status":
            say("Service: %s" % ("running" if running() else "stopped (`staff start`)"))
        for k, e in engine.registry().get("employees", {}).items():
            if e.get("status") == "retired":
                continue
            say("/%-12s %-10s %-28s %s · %d abilities" % (k, e["name"], e["role"][:28], e.get("status", "active"), len(abilities.effective(k))))
        return
    try:
        if args.cmd == "hire":
            ensure_home()
            hd = hire.hire(args.name, args.role, args.scope, supervisor=args.supervisor, emp_id=args.handle,
                           preset="super" if args.super else "default", model=args.model)
            say("Hired %s: /%s. They start within a minute." % (args.name, hd))
        elif args.cmd in ("pause", "resume", "retire"):
            hire.set_status(args.handle, {"pause": "paused", "resume": "active", "retire": "retired"}[args.cmd])
            say("%s: %s" % (args.handle, args.cmd + "d" if args.cmd != "pause" else "paused"))
        elif args.cmd == "abilities":
            if args.default or args.super:
                ids = abilities.preset("super" if args.super else "default")
            else:
                cur = set(abilities.chosen(args.handle))
                cur |= {x for x in args.on.split(",") if x}
                cur -= {x for x in args.off.split(",") if x}
                ids = sorted(cur)
            added, removed = hire.set_abilities(args.handle, ids, "terminal")
            say("; ".join(["+" + x for x in added] + ["−" + x for x in removed]) or "No change")
            say("On: " + ", ".join(sorted(abilities.effective(args.handle))))
        elif args.cmd == "group":
            import channels
            ch = args.channel or channels.guess(args.chat_id)
            if not ch:
                sys.exit("Which channel is that id from? Add --channel telegram|slack|discord")
            reg = engine.registry()
            reg.setdefault("team_chats", {})[ch] = args.chat_id
            if ch == "telegram":
                reg.setdefault("telegram", {})["group_id"] = args.chat_id
            engine.save_registry(reg, "%s team chat set" % ch)
            say({"telegram": "Team chat set. Add the bot to the group as an admin so it can read messages.",
                 "slack": "Team chat set. Invite the bot to that channel: /invite @YourBot.",
                 "discord": "Team chat set. Make sure the bot can view and post in that channel."}[ch])
        elif args.cmd == "run":
            emp = engine.employee(args.handle)
            me = next(iter(engine.registry().get("owners", {}).values()), {}).get("name", "Owner")
            import team
            res = engine.run(emp, team.chat_prompt(me, "the terminal", args.message), job="chat", session_key="terminal")
            say(res["text"])
        elif args.cmd == "skills":
            me = next(iter(engine.registry().get("owners", {}).values()), {}).get("name", "Owner")
            if not args.handle:
                rows = skillbook.listing(skillbook.TEAM_DIR, "team")
                for s in rows:
                    say("%-28s %s  (shared by %s)" % (s["name"], s["description"][:80], s.get("shared_from", "?")))
                if not rows:
                    say("No team skills yet. Share one: staff skills <handle> --share <name>")
            elif args.share:
                say(skillbook.share(args.handle, args.share, me))
            elif args.remove:
                say(skillbook.remove(args.handle, "own", args.remove, me))
            elif args.export:
                name, dst = args.export
                shutil.copytree(skillbook.folder(args.handle, "own", name), os.path.join(dst, name))
                say("Copied to %s. Anyone can drop that folder into an employee's skills/ (or the kit's core/skills/)." % os.path.join(dst, name))
            else:
                o = skillbook.overview(args.handle)
                for src, rows in (("own", o["own"]), ("team", o["team"]), ("kit", o["kit"])):
                    for s in rows:
                        flag = ("  [not loading: %s]" % s["problem"]) if s.get("problem") else ""
                        say("%-5s %-28s %s%s" % (src, s["name"], s["description"][:80], flag))
                if not any(o.values()):
                    say("No skills yet. Teach one in the panel, or in chat: \"From now on, when I ask for X, do Y.\"")
    except (hire.HireError, skillbook.SkillError) as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
